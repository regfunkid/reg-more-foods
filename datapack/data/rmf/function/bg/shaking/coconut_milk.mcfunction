# This function is fills empty Buckets with Coconut Milk. It also grants the advancement for making a Reg's More Foods item if the player doesn't already have it.
#
# First, remove the bucket...
clear @s[scores={rmf.shakerCooldown=0},gamemode=!creative] bucket 1
# Second, play a sound...
execute at @s[scores={rmf.shakerCooldown=0}] run playsound minecraft:item.bucket.fill
# Third, give the player Coconut Milk...
give @s[scores={rmf.shakerCooldown=0}] minecraft:milk_bucket[item_model="rmf:coconut_milk",minecraft:item_name='{translate:"item.rmf.coconut_milk"}',consumable={has_consume_particles:false,sound:entity.generic.drink,on_consume_effects:[{type:clear_all_effects}]},use_remainder={id:bucket},max_stack_size=1,custom_data={item_id:"rmf:coconut_milk"},lore=['{text:"Reg\'s More Foods",color:blue}']]
# Forth, give them the advancement (if they don't have it yet)...
advancement grant @s[advancements={rmf:crafted_food=false}] only rmf:crafted_food coconut milk
# Fifth, give them a shakerCooldown score of 0.5 seconds, so they don't fill Buckets every tick...
scoreboard players set @s[scores={rmf.shakerCooldown=0}] rmf.shakerCooldown 10
# ...Lastly, reset the Shaker Cup.
execute if items entity @s weapon.offhand minecraft:firework_star[minecraft:damage=0,custom_data~{contents:coconut_milk,item_id:"rmf:shaker_cup"}] if score @s rmf.shakerCooldown matches 10 run item replace entity @s weapon.offhand with minecraft:firework_star[item_model="rmf:shaker_cup",minecraft:damage=0,minecraft:max_damage=4,minecraft:max_stack_size=1,minecraft:item_name='{translate:"item.rmf.shaker_cup"}',custom_data={item_id:"rmf:shaker_cup"},lore=['{text:"Reg\'s More Foods",color:blue}']]